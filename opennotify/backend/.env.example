# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://opennotify:opennotify@localhost:5432/opennotify?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Email (console provider logs emails instead of sending)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@opennotify.app

# Profile checker provider: mock (safe default). Implement and register
# additional providers (e.g. a licensed data API) to swap at runtime.
PROFILE_CHECKER_PROVIDER=mock

# Monitoring
CHECK_INTERVAL_MINUTES=15
